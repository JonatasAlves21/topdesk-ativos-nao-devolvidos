# Copie para .env e preencha. Recomendado: guardar só referências do 1Password
# (op://<cofre>/<item>/<campo>) e rodar com `op run --env-file=.env -- node export.js`,
# assim nenhum segredo fica em texto puro no disco.

# ── TOPdesk ───────────────────────────────────────────────────────────────────
TOPDESK_URL=https://<sua-instancia>.topdesk.net
TOPDESK_EMAIL=op://<cofre>/<item-topdesk>/username
TOPDESK_TOKEN=op://<cofre>/<item-topdesk>/application-password

# IDs da sua instância (Asset Management e pessoa usada pela automação)
TOPDESK_TEMPLATE_NOTEBOOK=<id-do-template-de-notebook>
TOPDESK_TEMPLATE_CELULAR=<id-do-template-de-celular>
TOPDESK_STATUS_NAO_DEVOLVIDO=<id-do-status-nao-devolvido>
TOPDESK_AUTOMATION_CALLER_ID=<id-da-pessoa-que-abre-os-chamados-da-automacao>

# ── Microsoft Graph (app registration com Sites.ReadWrite.All ou Sites.Selected) ──
AZURE_TENANT_ID=op://<cofre>/<item-graph>/tenant-id
AZURE_CLIENT_ID=op://<cofre>/<item-graph>/client-id
AZURE_CLIENT_SECRET=op://<cofre>/<item-graph>/client-secret

# Relatório principal
SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
SHAREPOINT_FOLDER=<pasta/dentro/da/biblioteca>
SHAREPOINT_FILENAME=Nao Devolvidos.xlsx

# Relatório de ativos sem centro de custo (opcional; sem site, fica só local)
SHAREPOINT_EXAURIDOS_SITE_URL=
SHAREPOINT_EXAURIDOS_FOLDER=
SHAREPOINT_EXAURIDOS_FILENAME=Nao_Devolvidos_Sem_CC.xlsx
